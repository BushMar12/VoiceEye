{
  "name": "voiceeye",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "phone": "npm run build && vite preview --host --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:login": "wrangler login",
    "tunnel": "node scripts/tunnel.mjs",
    "tunnel:deploy": "node scripts/tunnel.mjs --deploy",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=voiceeye --branch=main --commit-dirty=true",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=voiceeye --branch=preview --commit-dirty=true",
    "verify:model": "node scripts/verify_model_artifact.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "onnxruntime-web": "^1.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.0.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.19.8",
    "vitest": "^4.1.4",
    "wrangler": "^4.84.1"
  }
}
